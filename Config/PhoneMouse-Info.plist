<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Phone Mouse</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Phone Mouse listens while you dictate, to type what you say on your Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Phone Mouse turns what you say into text and types it on your Mac.</string>
	<key>NSCameraUsageDescription</key>
	<string>Phone Mouse uses the camera once to scan the pairing code shown on your Mac.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_phonemouse._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Phone Mouse uses the local network to find your Mac and move its cursor.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
